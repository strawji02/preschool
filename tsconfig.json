{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      // `import 'server-only'`는 Next 컴파일러가 내부적으로 처리하지만 tsx/vitest는 모른다.
      // npm의 server-only 패키지는 Node에서 즉시 throw하므로 설치로는 해결되지 않는다
      // (Next 문서: 패키지 내용은 Next가 쓰지 않는다). 빈 모듈로 연결해 스크립트·테스트가
      // 서버 모듈을 불러올 수 있게 한다. Next 빌드의 가드는 자체 alias가 우선하므로 유지된다.
      "server-only": ["./src/test/server-only-stub.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "test-data"]
}
